# ============================================
# Production Dockerfile for Orchestrator
# Multi-stage build for optimal image size
# ============================================

# ============================================
# Stage 1: Dependencies
# Install all dependencies including devDependencies
# ============================================
# Note: Build context should be project root to access workspace packages
FROM node:22-alpine AS deps

# Install pnpm globally
RUN npm install -g pnpm@10.13.1

WORKDIR /app

# Copy workspace configuration and lock file from root
COPY pnpm-workspace.yaml pnpm-lock.yaml .pnpmfile.cjs ./

# Copy all package.json files
COPY packages/core/package.json ./packages/core/
COPY packages/errors/package.json ./packages/errors/
COPY packages/database/package.json ./packages/database/
COPY packages/kafka-producer/package.json ./packages/kafka-producer/
COPY packages/kafka-consumer/package.json ./packages/kafka-consumer/
COPY services/orchestrator/package.json ./services/orchestrator/

# Install all dependencies (including dev for build)
RUN pnpm install --frozen-lockfile

# Copy workspace package sources
COPY packages/core/tsconfig.json ./packages/core/
COPY packages/core/src ./packages/core/src

COPY packages/errors/tsconfig.json ./packages/errors/
COPY packages/errors/src ./packages/errors/src

COPY packages/database/tsconfig.json ./packages/database/
COPY packages/database/src ./packages/database/src

COPY packages/kafka-producer/tsconfig.json ./packages/kafka-producer/
COPY packages/kafka-producer/src ./packages/kafka-producer/src

COPY packages/kafka-consumer/tsconfig.json ./packages/kafka-consumer/
COPY packages/kafka-consumer/src ./packages/kafka-consumer/src

# Build workspace dependencies (order matters: core first, then packages)
RUN pnpm --filter @dtm/core run build
RUN pnpm --filter @dtm/errors run build
RUN pnpm --filter @dtm/database run build
RUN pnpm --filter @dtm/kafka-producer run build
RUN pnpm --filter @dtm/kafka-consumer run build

# ============================================
# Stage 2: Builder
# Build the application
# ============================================
FROM node:22-alpine AS builder

# Install pnpm globally
RUN npm install -g pnpm@10.13.1

WORKDIR /app

# Copy dependencies and built packages from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/services/orchestrator/node_modules ./services/orchestrator/node_modules
COPY --from=deps /app/packages/core ./packages/core
COPY --from=deps /app/packages/errors ./packages/errors
COPY --from=deps /app/packages/database ./packages/database
COPY --from=deps /app/packages/kafka-producer ./packages/kafka-producer
COPY --from=deps /app/packages/kafka-consumer ./packages/kafka-consumer
# Copy orchestrator package.json (needed for build scripts)
COPY services/orchestrator/package.json ./services/orchestrator/

# Copy orchestrator source code and config files (exclude node_modules, dist, etc.)
COPY services/orchestrator/tsconfig.json ./services/orchestrator/
COPY services/orchestrator/tsconfig.build.json ./services/orchestrator/
COPY services/orchestrator/nest-cli.json ./services/orchestrator/
COPY services/orchestrator/src ./services/orchestrator/src

WORKDIR /app/services/orchestrator

# Build the application
RUN pnpm run build

# ============================================
# Stage 3: Production Dependencies
# Install only production dependencies
# ============================================
FROM node:22-alpine AS prod-deps

# Install pnpm globally
RUN npm install -g pnpm@10.13.1

WORKDIR /app

# Copy workspace configuration and lock file from root
COPY pnpm-workspace.yaml pnpm-lock.yaml .pnpmfile.cjs ./

# Copy all package.json files
COPY packages/core/package.json ./packages/core/
COPY packages/errors/package.json ./packages/errors/
COPY packages/database/package.json ./packages/database/
COPY packages/kafka-producer/package.json ./packages/kafka-producer/
COPY packages/kafka-consumer/package.json ./packages/kafka-consumer/
COPY services/orchestrator/package.json ./services/orchestrator/

# Install only production dependencies
RUN pnpm install --frozen-lockfile --prod

# Copy workspace package sources (needed for runtime)
COPY packages/core/tsconfig.json ./packages/core/
COPY packages/core/src ./packages/core/src

COPY packages/errors/tsconfig.json ./packages/errors/
COPY packages/errors/src ./packages/errors/src

COPY packages/database/tsconfig.json ./packages/database/
COPY packages/database/src ./packages/database/src

COPY packages/kafka-producer/tsconfig.json ./packages/kafka-producer/
COPY packages/kafka-producer/src ./packages/kafka-producer/src

COPY packages/kafka-consumer/tsconfig.json ./packages/kafka-consumer/
COPY packages/kafka-consumer/src ./packages/kafka-consumer/src

# ============================================
# Stage 4: Runner
# Final production image
# ============================================
FROM node:22-alpine AS runner

# Set NODE_ENV to production
ENV NODE_ENV=production

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

WORKDIR /app

# Copy production dependencies
COPY --from=prod-deps --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=prod-deps --chown=nestjs:nodejs /app/services/orchestrator/node_modules ./services/orchestrator/node_modules
COPY --from=prod-deps --chown=nestjs:nodejs /app/packages ./packages
COPY --from=prod-deps --chown=nestjs:nodejs /app/workflows ./workflows

# Copy built application
COPY --from=builder --chown=nestjs:nodejs /app/services/orchestrator/dist ./services/orchestrator/dist

# Copy package.json for metadata
COPY --chown=nestjs:nodejs services/orchestrator/package.json ./services/orchestrator/

WORKDIR /app/services/orchestrator

# Switch to non-root user
USER nestjs

# Expose application port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start the application
CMD ["node", "dist/main"]
