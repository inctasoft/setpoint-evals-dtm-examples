{
  "name": "@dtm/orchestrator",
  "version": "0.0.1",
  "description": "DTM orchestrator — NestJS workflow engine",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"{src,apps,libs,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,apps,libs,test}/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:smoke": "jest --testPathPatterns=smoke --passWithNoTests",
    "test:contracts": "jest --config ./test/jest-contracts.json --passWithNoTests",
    "test:db": "jest --testPathPatterns=database --passWithNoTests",
    "test:integration": "jest --config ./test/jest-integration.json",
    "test:integration:ci": "ORCHESTRATOR_URL=http://localhost:3000 jest --config ./test/jest-integration.json --ci --reporters=default --reporters=jest-junit",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d dataSource.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d dataSource.ts",
    "migration:show": "npx typeorm-ts-node-commonjs migration:show -d dataSource.ts",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d dataSource.ts",
    "migrate": "env $(cat ../../.env | grep -v '^#' | grep -v '^[[:space:]]*$' | xargs) npm run migration:run"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1095.0",
    "@dtm-workflows/infra-provisioning": "workspace:*",
    "@dtm-workflows/iot-sensor-pipeline": "workspace:*",
    "@dtm-workflows/order-processing": "workspace:*",
    "@dtm-workflows/plan-execution": "workspace:*",
    "@dtm/core": "workspace:*",
    "@dtm/database": "workspace:*",
    "@dtm/kafka-consumer": "workspace:*",
    "@dtm/kafka-producer": "workspace:*",
    "@google-cloud/tasks": "^6.2.3",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.28",
    "axios": "^1.18.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "joi": "^18.2.3",
    "kafkajs": "^2.2.4",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertokens-node": "^24.0.3",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!uuid)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
