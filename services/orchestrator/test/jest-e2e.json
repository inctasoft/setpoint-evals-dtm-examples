{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!uuid)"
  ],
  "setupFilesAfterEnv": ["<rootDir>/jest-setup.js"],
  "testEnvironmentOptions": {
    "node": {
      "globals": {
        "crypto": "node"
      }
    }
  }
}
