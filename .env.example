# =============================================================================
# DTM - Distributed Task Manager — Environment Configuration
# =============================================================================
#
# RUNTIME DETECTION: The application automatically detects its runtime context:
#   - EKS:    K8S_SERVICE_HOST env var exists → Uses ConfigMap/Secrets
#   - Docker: /.dockerenv file exists → Uses Docker service names
#   - Local:  Neither → Uses localhost with mapped ports
#
# This means you don't need separate .env files for different modes!
# Just copy this file to .env and the app will auto-detect the right settings.
#
# Copy to .env:
#   cp .env.example .env
#
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment mode
NODE_ENV=development

# Server ports
PORT=3000
ORCHESTRATOR_PORT=3002

# Logging
LOG_LEVEL=debug

# Docker Compose project name
COMPOSE_PROJECT_NAME=dtm

# =============================================================================
# DATABASE - DTM Core
# =============================================================================
# Note: Host and port are auto-detected based on runtime context
# These values are fallbacks/overrides:
#   - Local: localhost:5448 (uses DTM_DB_PORT_HOST)
#   - Docker: dtm-db:5432 (uses DTM_DB_PORT)
#   - EKS: Uses DTM_DB_HOST directly

DTM_DB_HOST=dtm-db
DTM_DB_PORT=5432
DTM_DB_PORT_HOST=5448
DTM_DB_USER=dtm_user
DTM_DB_PASSWORD=your_password
DTM_DB_NAME=dtm

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================
# Note: Broker address is auto-detected based on runtime:
#   - Local: localhost:9093 (external listener)
#   - Docker: dtm-kafka:29092 (internal listener)
#   - EKS: Uses KAFKA_BROKER directly (MSK endpoint)

KAFKA_BROKER=dtm-kafka:29092
KAFKA_CONSUMER_GROUP_ID=dtm-service-group
KAFKA_TOPIC_JOB_SUBMITTED=dtm.jobs.submitted

# Kafka server configuration (for Docker Compose)
KAFKA_BROKER_ID=1
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:9093
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

# Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Topic configuration
KAFKA_TOPIC_JOB_SUBMITTED_PARTITIONS=2
KAFKA_TOPIC_JOB_SUBMITTED_REPLICATION=1

# Enable/Disable Kafka event publishing
PUBLISH_EVENTS_TO_KAFKA=true

# =============================================================================
# AWS / LOCALSTACK CONFIGURATION
# =============================================================================
# Note: Endpoints are auto-detected based on runtime:
#   - Local: http://localhost:4566
#   - Docker: http://localstack:4566
#   - EKS: Not set (uses real AWS with IAM roles)

AWS_REGION=us-east-1

# LocalStack credentials (not used in EKS - uses IAM roles)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS endpoint (auto-detected, override if needed)
AWS_SQS_ENDPOINT=http://localstack:4566

# =============================================================================
# TASK TRANSPORT (bus-agnosticism program)
# =============================================================================
# Selects the QueueTransport implementation for step dispatch:
#   sqs         — default; LocalStack/AWS SQS (native redelivery + DLQ)
#   cloud-tasks — GCP Cloud Tasks
#   zmq         — ZeroMQ ROUTER (orchestrator) + zmq-worker-host DEALER fleet
#                 (docker-compose.zmq.yml, profile `zmq-tasks`; mixed mode =
#                 zmq tasks + Kafka events unchanged)
# QUEUE_TRANSPORT=sqs
#
# zmq profile only — orchestrator ROUTER bind + worker liveness tuning:
# ZMQ_TASKS_ENDPOINT=tcp://0.0.0.0:5557
# ZMQ_TASK_ACK_TIMEOUT_MS=2000
# ZMQ_WORKER_SILENCE_MS=15000
# ZMQ_WORKER_SWEEP_INTERVAL_MS=5000
# ZMQ_TASKS_PORT_HOST=5557
# Worker hosts (docker-compose.zmq.yml) read:
# ZMQ_HEARTBEAT_INTERVAL_MS=5000
#
# Event bus (Phase 3):
#   kafka — default; brokered events + acks
#   zmq   — ZeroMQ PUB/SUB events + PUSH/PULL acks (docker-compose.zmq.yml;
#           the event-republish scan auto-activates for dropped publishes)
# EVENT_BUS=kafka
# ZMQ_EVENTS_ENDPOINT=tcp://0.0.0.0:5558
# ZMQ_ACKS_ENDPOINT=tcp://0.0.0.0:5559
# EVENT_REPUBLISH_LEASE_SECONDS=60
# EVENT_REPUBLISH_SCAN_FORCE_ENABLED=false

# Orchestrator callback URL for Lambda workers
# Runtime-aware configuration:
#   - Local: http://localhost:ORCHESTRATOR_PORT_HOST (e.g., localhost:3002)
#   - Docker: http://ORCHESTRATOR_DOCKER_HOST:PORT (e.g., dtm-orchestrator:3000)
#   - EKS: Uses ORCHESTRATOR_CALLBACK_URL or http://orchestrator:PORT
# ORCHESTRATOR_CALLBACK_URL: Leave unset to use runtime-aware auto-detection:
#   - Local mode: http://localhost:ORCHESTRATOR_PORT_HOST (localhost:3002)
#   - Docker mode: http://ORCHESTRATOR_DOCKER_HOST:PORT (dtm-orchestrator:3000)
ORCHESTRATOR_DOCKER_HOST=dtm-orchestrator
ORCHESTRATOR_PORT_HOST=3002

# Disable SuperTokens auth in dev so the SE suite can hit the API without a session.
# Production deploys MUST override this (set DISABLE_AUTH=false or remove).
DISABLE_AUTH=true

# Frontend counterpart of DISABLE_AUTH — DISABLE_AUTH alone only bypasses the
# BACKEND API guard; apps/monitor (the Preact dashboard) still independently
# redirects a session-less browser to /auth via SuperTokens. Set this (as a
# Vite build/dev env var, e.g. `VITE_DISABLE_AUTH=true pnpm dev` in
# apps/monitor/) to skip that redirect for headless Playwright coverage of
# the monitor UI. Fails CLOSED — only the literal string "true" bypasses.
# NEVER set in a production build.
VITE_DISABLE_AUTH=false

# LocalStack settings
LOCALSTACK_SERVICES=sqs,lambda,s3
LOCALSTACK_DEBUG=1
LOCALSTACK_PERSISTENCE=0
CLEANUP_UNUSED_QUEUES=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Simulated Delays Feature (for testing/demos)
# SECURITY: MUST be 'false' in production!
ENABLE_REQUESTS_FOR_SIMULATED_DELAYS=true

# Dev Acknowledgement Simulator
# Simulates external system acknowledgements in development
# SECURITY: MUST be 'false' in production!
ENABLE_DEV_ACK_SIMULATOR=true

# Job Request Deduplication
# Prevents duplicate job requests
# Recommended: 'true' in production
ENABLE_DEDUPLICATION=false

# Setpoint Evals "run" endpoint (POST /api/v1/evals/:suite/:id/run)
# Re-issues an eval's server-parsed README Payload as a real job — dev/demo only.
# SECURITY: set to 'false' anywhere re-issuing arbitrary suite fixtures as real
# jobs is undesirable. GET discovery (/api/v1/evals) is never gated by this flag.
ENABLE_EVAL_RUN_API=true

# Per-Request Feature Flag Overrides (Layer 3 master switch)
# Allows job payloads to override workflow.config.ts featureFlags.defaults via
# payload.featureFlags, gated by each workflow's clientOverridable allowlist.
# See CLAUDE.md § "Feature Flags (Three-Layer Resolution)".
# Recommended: 'false' in production unless per-request overrides are a deliberate API surface.
ENABLE_REQUEST_FEATURE_FLAGS=true

# =============================================================================
# PGADMIN (Development Only)
# =============================================================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# =============================================================================
# PORT MAPPINGS (for Docker Compose)
# =============================================================================
# These are used by docker-compose.yml for port mappings
KAFKA_PORT_INTERNAL=9092
KAFKA_PORT_HOST=9093
ZOOKEEPER_PORT=2181
LOCALSTACK_PORT=4567
LOCALSTACK_PORT_RANGE_START=4510
LOCALSTACK_PORT_RANGE_END=4559
