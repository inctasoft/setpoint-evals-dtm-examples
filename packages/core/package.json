{
  "name": "@dtm/core",
  "version": "0.1.0",
  "description": "DTM (Distributed Task Manager) core interfaces and types",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint:check": "echo 'no lint configured (no eslint config in this package)'",
    "lint:fix": "echo 'no lint configured (no eslint config in this package)'",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "dtm",
    "distributed-task-manager",
    "workflow",
    "orchestration",
    "interfaces"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
