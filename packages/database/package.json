{
  "name": "@dtm/database",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Shared database entities, migrations, and TypeORM configuration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --outDir .build-tmp && mkdir -p dist && rm -rf dist/* && cp -r .build-tmp/. dist/ && rm -rf .build-tmp",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix --max-warnings=0",
    "lint:check": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs -d src/config/typeorm.config.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/config/typeorm.config.ts migration:revert",
    "migration:generate": "typeorm-ts-node-commonjs -d src/config/typeorm.config.ts migration:generate",
    "migration:create": "typeorm-ts-node-commonjs -d src/config/typeorm.config.ts migration:create",
    "migration:show": "typeorm-ts-node-commonjs -d src/config/typeorm.config.ts migration:show"
  },
  "dependencies": {
    "@dtm/core": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "typeorm": "^0.3.27",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
