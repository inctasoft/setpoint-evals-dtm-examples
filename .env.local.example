# .env.local — Host-side environment for running SEs outside Docker
#
# Copy this file to .env.local and adjust ports if your setup differs.
# SEs source this file (via setpoint-evals/shared/helpers.sh) to get correct
# host-mapped ports for services running in Docker containers.
#
# If .env.local does not exist, SEs fall back to .env which uses
# container-internal ports. This file overrides only the values
# that differ between host and container.

ORCHESTRATOR_HOST=http://localhost:3002
LOCALSTACK_PORT=4567
DB_HOST=localhost
DB_PORT=5448
API_VERSION=v1
