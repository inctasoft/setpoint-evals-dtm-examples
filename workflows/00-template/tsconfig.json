{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "outDir": "./dist",
    "declaration": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["workflow.config.ts", "workers/src/**/*.ts", "dev-tools/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
