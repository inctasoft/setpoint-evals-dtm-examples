# ============================================
# DTM SQS Poller — Simulator Mode
# ============================================
# Built from monorepo root to access core packages.
# Unlike the standalone Dockerfile.dev, this builds all dependencies
# from source but does NOT include any workflow code.
#
# Workflow handlers and DataSources are mounted at runtime via:
#   HANDLER_MAP_PATHS, DATASOURCE_PATHS, WORKFLOW_CONFIG_PATHS
#
# Queues are auto-created on startup (no localstack-init.sh needed).
#
# Build context: monorepo root (the monorepo root)
# ============================================

FROM node:22-alpine

RUN npm install -g pnpm@10.13.1 tsx@4.7.0

WORKDIR /app

# Copy workspace configuration files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs ./

# Copy core package.json files for dependency resolution
COPY packages/core/package.json ./packages/core/
COPY packages/worker-sdk/package.json ./packages/worker-sdk/
COPY tools/sqs-poller/package.json ./tools/sqs-poller/

# Copy workflow package.json stubs for pnpm workspace resolution
# (source code is NOT copied — mounted at runtime via volumes)
COPY workflows/order-processing/package.json ./workflows/order-processing/
COPY workflows/iot-sensor-pipeline/package.json ./workflows/iot-sensor-pipeline/
COPY workflows/infra-provisioning/package.json ./workflows/infra-provisioning/

# Also copy worker + typeorm + source-db package.json stubs for the
# optional dependencies declared in sqs-poller's package.json
COPY workflows/order-processing/workers/package.json ./workflows/order-processing/workers/
COPY workflows/iot-sensor-pipeline/workers/package.json ./workflows/iot-sensor-pipeline/workers/
COPY workflows/infra-provisioning/workers/package.json ./workflows/infra-provisioning/workers/
COPY workflows/order-processing/source-db/package.json ./workflows/order-processing/source-db/
COPY workflows/iot-sensor-pipeline/source-db/package.json ./workflows/iot-sensor-pipeline/source-db/
COPY workflows/infra-provisioning/source-db/package.json ./workflows/infra-provisioning/source-db/

# Additional packages needed for the orchestrator dependency chain
COPY packages/errors/package.json ./packages/errors/
COPY packages/database/package.json ./packages/database/
COPY packages/kafka-producer/package.json ./packages/kafka-producer/
COPY packages/kafka-consumer/package.json ./packages/kafka-consumer/
COPY services/orchestrator/package.json ./services/orchestrator/

# Install dependencies (all workspace packages resolved, including typeorm/pg)
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy and build core packages
COPY packages/core/tsconfig.json ./packages/core/
COPY packages/core/src ./packages/core/src
RUN pnpm --filter @dtm/core run build

COPY packages/worker-sdk/tsconfig.json ./packages/worker-sdk/
COPY packages/worker-sdk/src ./packages/worker-sdk/src
RUN pnpm --filter @dtm/worker-sdk run build

# Copy poller source (includes simulator entry points)
COPY tools/sqs-poller/tsconfig.json ./tools/sqs-poller/
COPY tools/sqs-poller/src ./tools/sqs-poller/src

WORKDIR /app/tools/sqs-poller

EXPOSE 9230

# Run the simulator poller with tsx
CMD ["tsx", "src/poller.simulator.ts"]
