{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": "../..",
    "paths": {
      "@dtm/core": ["packages/core/src/index.ts"],
      "@dtm/core/*": ["packages/core/src/*"],
      "@dtm/worker-sdk": ["packages/worker-sdk/src/index.ts"],
      "@dtm/worker-sdk/*": ["packages/worker-sdk/src/*"],
      "@dtm-workflows/order-processing": ["workflows/order-processing/workflow.config.ts"],
      "@dtm-workflows/order-processing-workers": ["workflows/order-processing/workers/src/index.ts"],
      "@dtm-workflows/order-processing-workers/*": ["workflows/order-processing/workers/src/*"],
      "@dtm-workflows/order-processing-typeorm": ["workflows/order-processing/source-db/src/index.ts"],
      "@dtm-workflows/iot-sensor-pipeline": ["workflows/iot-sensor-pipeline/workflow.config.ts"],
      "@dtm-workflows/iot-sensor-pipeline-workers": ["workflows/iot-sensor-pipeline/workers/src/index.ts"],
      "@dtm-workflows/iot-sensor-pipeline-workers/*": ["workflows/iot-sensor-pipeline/workers/src/*"],
      "@dtm-workflows/iot-sensor-pipeline-typeorm": ["workflows/iot-sensor-pipeline/source-db/src/index.ts"],
      "@dtm-workflows/infra-provisioning": ["workflows/infra-provisioning/workflow.config.ts"],
      "@dtm-workflows/infra-provisioning-workers": ["workflows/infra-provisioning/workers/src/index.ts"],
      "@dtm-workflows/infra-provisioning-workers/*": ["workflows/infra-provisioning/workers/src/*"],
      "@dtm-workflows/infra-provisioning-typeorm": ["workflows/infra-provisioning/source-db/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
