{
  "name": "@dtm/setpoint-evals-playwright",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "description": "Playwright-based Setpoint Eval tests for DTM",
  "scripts": {
    "test": "playwright test",
    "test:core": "playwright test --project=core-safe --project=core-destructive",
    "test:core:safe": "playwright test --project=core-safe",
    "test:core:destructive": "playwright test --project=core-destructive",
    "test:workflows": "playwright test --project=workflow-order-processing --project=workflow-iot-sensor-pipeline --project=workflow-infra-provisioning",
    "test:workflow:order": "playwright test --project=workflow-order-processing",
    "test:workflow:iot": "playwright test --project=workflow-iot-sensor-pipeline",
    "test:workflow:infra": "playwright test --project=workflow-infra-provisioning",
    "test:ui:scenarios": "playwright test --project=ui-scenarios",
    "test:demos": "playwright test --project=demo-videos",
    "test:demo:order": "playwright test --project=demo-videos -g 'order-processing'",
    "test:demo:iot": "playwright test --project=demo-videos -g 'IoT'",
    "test:demo:infra": "playwright test --project=demo-videos -g 'Infra'",
    "test:demo:zmq": "playwright test --project=demo-videos -g 'ZeroMQ'",
    "test:demo:multi": "playwright test --project=demo-videos -g 'Multi-Job'",
    "test:demo:story": "playwright test --project=demo-videos -g 'STORY'",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/pg": "^8.11.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
