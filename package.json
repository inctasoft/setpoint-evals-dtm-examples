{
  "name": "dtm",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "description": "DTM - Distributed Task Manager",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "prepare": "husky",
    "postinstall": "node scripts/setup-env.cjs",
    "setup:env:force": "node scripts/setup-env.cjs --force",
    "clean": "./scripts/clean.sh",
    "clean:deps": "./scripts/clean.sh --deps",
    "clean:all": "./scripts/clean-all.sh",
    "infra": "./scripts/local-env.sh start --standalone",
    "infra:integrated": "./scripts/local-env.sh start --integrated",
    "build": "pnpm run build:packages && pnpm run build:orchestrator && pnpm run build:workers && pnpm run build:frontend",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:orchestrator": "pnpm --filter \"./services/orchestrator\" run build",
    "build:workers": "pnpm --filter \"./tools/*\" run build",
    "build:frontend": "pnpm --filter \"./apps/monitor\" run build",
    "dev": "pnpm --filter \"./services/orchestrator\" run start:dev",
    "dev:debug": "pnpm --filter \"./services/orchestrator\" run start:debug",
    "start": "pnpm --filter \"./services/orchestrator\" run start:prod",
    "test": "pnpm --filter \"./services/orchestrator\" run test",
    "test:watch": "pnpm --filter \"./services/orchestrator\" run test:watch",
    "test:cov": "pnpm --filter \"./services/orchestrator\" run test:cov",
    "test:integration": "ORCHESTRATOR_URL=http://localhost:3000 pnpm --filter \"./services/orchestrator\" run test:integration",
    "test:integration:ci": "pnpm --filter \"./services/orchestrator\" run test:integration:ci",
    "test:e2e": "pnpm --filter \"./services/orchestrator\" run test:e2e",
    "lint": "pnpm --filter \"./services/orchestrator\" run lint:check",
    "lint:check": "pnpm --filter \"./packages/*\" run lint:check && pnpm --filter \"./services/orchestrator\" run lint:check && pnpm --filter \"./tools/*\" run lint:check && pnpm --filter \"./apps/monitor\" run lint",
    "lint:fix": "pnpm --filter \"./packages/*\" run lint:fix && pnpm --filter \"./services/orchestrator\" run lint:fix && pnpm --filter \"./tools/*\" run lint:fix",
    "format": "pnpm --filter \"./packages/*\" run format && pnpm --filter \"./services/orchestrator\" run format && pnpm --filter \"./tools/*\" run format",
    "format:check": "pnpm --filter \"./packages/*\" run format:check && pnpm --filter \"./services/orchestrator\" run format:check && pnpm --filter \"./tools/*\" run format:check",
    "ste:playwright": "pnpm --filter @dtm/ste-playwright test",
    "ste:playwright:core": "pnpm --filter @dtm/ste-playwright test:core",
    "ste:playwright:core:safe": "pnpm --filter @dtm/ste-playwright test:core:safe",
    "ste:playwright:demos": "pnpm --filter @dtm/ste-playwright test:demos",
    "ste:playwright:demo:order": "pnpm --filter @dtm/ste-playwright test:demo:order",
    "ste:playwright:demo:iot": "pnpm --filter @dtm/ste-playwright test:demo:iot",
    "ste:playwright:demo:infra": "pnpm --filter @dtm/ste-playwright test:demo:infra",
    "ste:playwright:demo:multi": "pnpm --filter @dtm/ste-playwright test:demo:multi"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "kafkajs": "^2.2.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
