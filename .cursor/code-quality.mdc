## 🚨 Critical Quality Rules

### 1. No Hardcoded Values
```typescript
// ❌ Bad
if (status === 'completed') { }
const maxRetries = 3;

// ✅ Good
if (status === JobStatus.COMPLETED) { }
const maxRetries = process.env.MAX_RETRIES || DEFAULT_MAX_RETRIES;
```

### 2. Always Handle Errors
```typescript
// ❌ Bad
async function processJob(jobId: string) {
  const job = await jobRepository.findById(jobId);
  return job.process();
}

// ✅ Good
async function processJob(jobId: string): Promise<ProcessResult> {
  try {
    const job = await jobRepository.findById(jobId);
    if (!job) {
      throw new NotFoundException(`Job ${jobId} not found`);
    }
    return await job.process();
  } catch (error) {
    this.logger.error(`Failed to process job ${jobId}`, error);
    throw error;
  }
}
```

### 3. Validate Inputs
```typescript
// ❌ Bad
function createJob(payload: any) {
  return this.repository.save(payload);
}

// ✅ Good
@Post()
async createJob(@Body() dto: CreateJobDto): Promise<JobResponse> {
  // class-validator automatically validates DTO
  const job = await this.service.createJob(dto);
  return this.mapper.toResponse(job);
}
```

### 4. Use Typed Responses
```typescript
// ❌ Bad
async function getJob(id: string) {
  return this.repository.findOne({ where: { id } });
}

// ✅ Good
async function getJob(id: string): Promise<Job | null> {
  return this.repository.findOne({ where: { id } });
}
```

### 5. Avoid Magic Numbers
```typescript
// ❌ Bad
if (retryCount > 3) { }
setTimeout(callback, 5000);

// ✅ Good
const MAX_RETRY_COUNT = 3;
const CALLBACK_DELAY_MS = 5000;

if (retryCount > MAX_RETRY_COUNT) { }
setTimeout(callback, CALLBACK_DELAY_MS);
```

