## 🛡️ Input Validation

### Always Validate DTOs
```typescript
import { IsString, IsNumber, IsOptional, Min, Max } from 'class-validator';

export class CreateJobDto {
  @IsString()
  entityKey: string;

  @IsOptional()
  @IsString()
  deduplicationKey?: string;

  @IsString()
  @Length(1, 255)
  externalSystemId: string;

  // ✅ Validation happens automatically via class-validator
}
```

### Sanitize Database Queries
```typescript
// ✅ Good: Parameterized queries (TypeORM does this)
const job = await this.repo
  .createQueryBuilder('job')
  .where('job.customer_id = :id', { id: customerId })
  .getOne();

// ❌ Bad: String concatenation (SQL injection risk)
const job = await this.repo.query(
  `SELECT * FROM jobs WHERE customer_id = ${customerId}`
);
```

### Validate External Data
```typescript
// ✅ Good: Validate Kafka messages
async handleMessage(payload: EachMessagePayload): Promise<void> {
  const { message } = payload;
  
  try {
    const data = JSON.parse(message.value?.toString() || '{}');
    
    // Validate structure
    if (!data.orderId || !data.customerId) {
      throw new BadRequestException('Invalid message format');
    }

    // Validate types
    if (typeof data.customerId !== 'number') {
      throw new BadRequestException('customerId must be number');
    }
    
    // Process validated data
    await this.processMessage(data);
  } catch (error) {
    this.logger.error('Invalid message', error);
    // Don't process invalid messages
  }
}
```

