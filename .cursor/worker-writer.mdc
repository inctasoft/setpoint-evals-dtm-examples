## Output (Processing) Worker Pattern

```typescript
import { SQSEvent, SQSBatchResponse, Context, SQSRecord } from "aws-lambda";
import {
  createLogger,
  sendSuccessCallback,
  sendFailureCallback,
  getSQSMessageAttributes,
  buildRetryMetadata,
  getSimulatedDelays,
  createBatchItemFailure,
} from "@dtm/worker-sdk";

const STEP_NAME = "SubmitYourEntity";

async function processRecord(record: SQSRecord): Promise<void> {
  const startTime = Date.now();
  const message = JSON.parse(record.body);
  const { jobId, stepId, input, callbackUrl } = message;
  const logger = createLogger(jobId, STEP_NAME);
  const retryMetadata = buildRetryMetadata(record, getSQSMessageAttributes(record), startTime);

  try {
    const delays = getSimulatedDelays(input.testOptions, "submitYourEntity");
    if (delays.delay > 0) {
      await new Promise((r) => setTimeout(r, delays.delay));
    }

    // Get source data from dependency (input step)
    const sourceData = input.dependencyData?.ValidateYourEntity;
    if (!sourceData?.records) {
      throw new Error("Missing data from ValidateYourEntity step");
    }

    // Process all records
    const processed = sourceData.records.map(processRecord);

    await sendSuccessCallback(
      callbackUrl, jobId, stepId,
      { processedRecords: processed },  // Key must match callback service!
      processed.length, retryMetadata, STEP_NAME,
    );
  } catch (error) {
    await sendFailureCallback(
      callbackUrl, jobId, stepId,
      error instanceof Error ? error.message : String(error),
      retryMetadata, STEP_NAME,
    );
    throw error;
  }
}
```

