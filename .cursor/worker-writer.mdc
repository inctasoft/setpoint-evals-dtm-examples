## Input (Source) Worker Pattern

```typescript
import { SQSEvent, SQSBatchResponse, Context, SQSRecord } from "aws-lambda";
import {
  createLogger,
  sendSuccessCallback,
  sendFailureCallback,
  getSQSMessageAttributes,
  buildRetryMetadata,
  getSimulatedDelays,
  createBatchItemFailure,
} from "@dtm/worker-sdk";

interface SourceWorkMessage {
  jobId: string;
  stepId: string;
  input: {
    // Workflow-specific fields from job payload
    testOptions?: Record<string, unknown>;
  };
  callbackUrl: string;
}

const STEP_NAME = "ValidateYourEntity";

export async function handler(
  event: SQSEvent,
  context: Context,
): Promise<SQSBatchResponse> {
  const batchItemFailures: { itemIdentifier: string }[] = [];
  for (const record of event.Records) {
    try {
      await processRecord(record);
    } catch (error) {
      batchItemFailures.push(createBatchItemFailure(record));
    }
  }
  return { batchItemFailures };
}

async function processRecord(record: SQSRecord): Promise<void> {
  const startTime = Date.now();
  const message: SourceWorkMessage = JSON.parse(record.body);
  const { jobId, stepId, input, callbackUrl } = message;
  const logger = createLogger(jobId, STEP_NAME);
  const retryMetadata = buildRetryMetadata(record, getSQSMessageAttributes(record), startTime);

  try {
    // Handle simulated delays for testing
    const delays = getSimulatedDelays(input.testOptions, "validateYourEntity");
    if (delays.delay > 0) {
      await new Promise((r) => setTimeout(r, delays.delay));
    }

    // Query data from source system
    const data = await querySourceSystem(input.entityId);

    // Send success callback
    await sendSuccessCallback(
      callbackUrl, jobId, stepId,
      { records: data, retrievedAt: new Date().toISOString() },
      data.length, retryMetadata, STEP_NAME,
    );
  } catch (error) {
    await sendFailureCallback(
      callbackUrl, jobId, stepId,
      error instanceof Error ? error.message : String(error),
      retryMetadata, STEP_NAME,
    );
    throw error;
  }
}
```

